<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f4f1ff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#ffffff">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/website_app_name"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#162033" />

        <Button
            android:id="@+id/checkerButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/mode_check" />

        <Button
            android:id="@+id/browserButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/open_chrome" />
    </LinearLayout>

    <TextView
        android:id="@+id/modeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/website_app_hint"
        android:textSize="12sp"
        android:textColor="#3b2c73"
        android:background="#efe9ff" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
