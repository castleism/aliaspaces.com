<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f4f1ff">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:background="#ffffff">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="@string/app_name"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#162033" />

            <Button
                android:id="@+id/checkButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="64dp"
                android:text="@string/mode_check" />

            <Button
                android:id="@+id/webAppButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="64dp"
                android:text="@string/mode_website" />

            <Button
                android:id="@+id/socialButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="64dp"
                android:text="@string/mode_social" />

            <Button
                android:id="@+id/localButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="64dp"
                android:text="@string/mode_local" />

            <Button
                android:id="@+id/browserButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="64dp"
                android:text="@string/open_chrome" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/modeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/check_mode_hint"
        android:textSize="12sp"
        android:textColor="#3b2c73"
        android:background="#efe9ff" />

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/offline_hint"
        android:textSize="12sp"
        android:textColor="#9b2c4a"
        android:background="#f8e6eb"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
